# Frontend Environment Configuration (Optional on Vercel: defaults to relative /api when hosted together)
VITE_API_BASE_URL=

# Backend Environment Configuration
# Works with Neon, Supabase, Vercel Postgres, Railway, or local PostgreSQL:
# e.g. postgres://default:password@ep-cool-fog-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/career_navigator

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# CORS (Optional: automatically allows https://*.vercel.app in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

