# Database Connection (PostgreSQL or SQLite)
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/career_navigator
# Example SQLite: sqlite:///./career_navigator.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/career_navigator

# Google Gemini API Key for AI Agents (Roadmap, Discovery, Mock Interview)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Allowed CORS Origins (comma-separated, optional)
# Defaults to localhost dev ports if omitted
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

